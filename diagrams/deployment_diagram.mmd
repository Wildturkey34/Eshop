flowchart TB
    %% Deployment Diagram for E-shop Microservices
    
    subgraph Internet
        Stripe[Stripe API]
        ImageKit[ImageKit API]
    end

    subgraph Client_Machine [Client Environment]
        Browser[Web Browser / Next.js Runtime]
    end

    subgraph Server_Node [Production Server - Docker Environment]
        direction TB
        
        subgraph Containers [Service Containers]
            Gateway[API Gateway]
            BusSvc[Business Microservices]
            TFSvc[TensorFlow Rec Svc]
        end

        subgraph Data_Layer [Persistence & Messaging]
            MongoDB[(MongoDB)]
            Redis[(Redis)]
            Kafka{{Apache Kafka}}
        end
    end

    %% Physical Connections
    Browser -- "HTTP/HTTPS (JWT)" --> Gateway
    Browser -- "WebSockets" --> BusSvc
    
    Gateway --> BusSvc
    BusSvc <--> TFSvc
    
    BusSvc -- "Prisma/Mongoose" --> MongoDB
    BusSvc -- "Cache/Presence" --> Redis
    BusSvc -- "Produce/Consume" --> Kafka
    
    BusSvc -- "External API" --> Stripe
    BusSvc -- "Image Uploads" --> ImageKit

    %% Styling
    style Server_Node fill:#fffde7,stroke:#fbc02d
    style Containers fill:#e3f2fd,stroke:#1976d2
    style Data_Layer fill:#f1f8e9,stroke:#558b2f
    style Internet fill:#eeeeee,stroke:#9e9e9e
