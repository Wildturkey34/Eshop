{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react",
    "outDir": "out-tsc/auth-service",
    "types": ["node", "express"],
    "rootDir": "../../",
    "tsBuildInfoFile": "out-tsc/auth-service/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "../../packages/**/*.ts",
    "../../packages/components/input/index.tsx"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../packages/libs/redis"
    },
    {
      "path": "../../packages/middleware"
    },
    {
      "path": "../../packages/error-handler"
    },
    {
      "path": "../../packages/libs/prisma"
    }
  ]
}
